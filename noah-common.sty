\setlength{\parindent}{0pt}

% Libertinus/Latin Modern can look slightly tight immediately around text
% delimiters. Add a very small optical gap without changing typed spaces.
\SetExtraKerning
  [name=noah-delimiters, unit=em]
  {encoding={TU}}
  {
    ( = {45,},
    ) = {,45},
    [ = {45,},
    ] = {,45}
  }
\microtypecontext{kerning=noah-delimiters}

% Title-case only for English
\newcommand{\NoahTitleCase}[1]{%
  \ifnoah@danish #1\else \titlecap{#1}\fi
}
\newcommand{\ReportTitle}{\NoahTitleCase{\@title}}

\ExplSyntaxOn
\newcommand{\NoahStoreTitleCase}[2]{%
  \ifnoah@danish
    \global\def#1{#2}%
  \else
    \begingroup
      \setbox0=\hbox{\titlecap{#2}\global\let\noah_titlecase_temp\@thestring}%
      \cs_set:Npn \uppercase ##1 {\text_uppercase:n{##1}}%
      \xdef#1{\noah_titlecase_temp}%
    \endgroup
  \fi
}
\ExplSyntaxOff

% ---------------------------------------------------------------------------
% Mathematics and units
% ---------------------------------------------------------------------------
\providecommand{\Vec}[1]{\symbfit{#1}}
\renewcommand{\Vec}[1]{\symbfit{#1}}
\newcommand{\Mat}[1]{\symbfup{#1}}
\renewcommand{\Re}{\operatorname{Re}}
\renewcommand{\Im}{\operatorname{Im}}
\DeclareMathOperator{\grad}{grad}

\RequirePackage{siunitx}
\ifnoah@danish
  \sisetup{output-decimal-marker={,}}
\else
  \sisetup{output-decimal-marker={.}}
\fi
\sisetup{
  exponent-product=\cdot,
  group-separator={\,},
  group-minimum-digits=5,
  per-mode=fraction,
  detect-all
}

% Inline alternatives using powers instead of fractions
\NewDocumentCommand{\iqty}{O{}mm}{\qty[per-mode=power-positive-first,#1]{#2}{#3}}
\NewDocumentCommand{\isi}{O{}m}{\si[per-mode=power-positive-first,#1]{#2}}

