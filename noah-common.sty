\newcommand{\NoahConfigureListsAndCaptions}[3]{%
  \setlist{%
    topsep=#1,
    itemsep=#2,
    parsep=0pt,
    leftmargin=*%
  }%
  \captionsetup{%
    font=small,
    labelfont=bf,
    format=hang,
    justification=raggedright,
    singlelinecheck=#3%
  }%
}

\NewDocumentCommand{\incfig}{O{1} m o}{%
  \begingroup
    \def\svgwidth{#1\columnwidth}%
    \import{./figures/}{#2.pdf_tex}%
  \endgroup
