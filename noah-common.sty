\tl_new:N \g_noah_logo_tl
\tl_new:N \g_noah_pdf_subject_tl
\tl_new:N \g_noah_date_iso_tl
\tl_new:N \g_noah_submission_date_tl
\tl_new:N \g_noah_submission_date_iso_tl
\tl_new:N \g_noah_candidate_number_tl

\cs_new:Npn \noah_two_digits:n #1
  { \int_compare:nNnTF {#1} < {10} {0\int_to_arabic:n{#1}} {\int_to_arabic:n{#1}} }
\tl_gset:Nx \g_noah_date_iso_tl
  { \int_to_arabic:n{\year}-\noah_two_digits:n{\month}-\noah_two_digits:n{\day} }
\tl_gset:Nn \g_noah_logo_tl {figures/AU.pdf}
\ifnoah@danish
  \tl_gset:Nn \g_noah_department_tl {Institut~for~Mekanik~og~Produktion}
  \tl_gset:Nn \g_noah_university_tl {Aarhus~Universitet}
\else
  \tl_gset:Nn \g_noah_department_tl {Department~of~Mechanical~and~Production~Engineering}
  \tl_gset:Nn \g_noah_university_tl {Aarhus~University}
\fi

\cs_new_protected:Npn \NoahDefaultAuthor #1#2
  {
    \seq_gclear:N \g_noah_author_name_seq
    \seq_gclear:N \g_noah_author_id_seq
    \seq_gput_right:Nn \g_noah_author_name_seq {#1}
    \seq_gput_right:Nn \g_noah_author_id_seq {#2}
  }
\ExplSyntaxOff
\InputIfFileExists{noah-private.cfg}{}{}
\ExplSyntaxOn

\cs_new_protected:Npn \noah_set_primary_name:n #1
  {
    \seq_if_empty:NTF \g_noah_author_name_seq
      {
        \seq_gput_right:Nn \g_noah_author_name_seq {#1}
        \seq_gput_right:Nn \g_noah_author_id_seq {}
      }
      {\seq_gset_item:Nnn \g_noah_author_name_seq {1} {#1}}
  }
\cs_new_protected:Npn \noah_set_primary_id:n #1
  {
    \seq_if_empty:NTF \g_noah_author_id_seq
      {
        \seq_gput_right:Nn \g_noah_author_name_seq {}
        \seq_gput_right:Nn \g_noah_author_id_seq {#1}
      }
      {\seq_gset_item:Nnn \g_noah_author_id_seq {1} {#1}}
  }
\RenewDocumentCommand{\author}{m}{\noah_set_primary_name:n{#1}\gdef\@author{#1}}
\NewDocumentCommand{\studentid}{m}{\noah_set_primary_id:n{#1}}
\NewDocumentCommand{\addauthor}{mm}
  {
    \seq_gput_right:Nn \g_noah_author_name_seq {#1}
    \seq_gput_right:Nn \g_noah_author_id_seq {#2}
  }

\keys_define:nn {noah/setup}
  {
    course .tl_gset:N = \g_noah_course_tl,
    course-code .tl_gset:N = \g_noah_course_code_tl,
    course-short .tl_gset:N = \g_noah_course_short_tl,
    short-course .meta:n = {course-short={#1}},
    running-title .tl_gset:N = \g_noah_running_title_tl,
    short-title .meta:n = {running-title={#1}},
    instructor .tl_gset:N = \g_noah_instructor_tl,
    semester .tl_gset:N = \g_noah_semester_tl,
    department .tl_gset:N = \g_noah_department_tl,
    university .tl_gset:N = \g_noah_university_tl,
    logo .tl_gset:N = \g_noah_logo_tl,
    pdf-subject .tl_gset:N = \g_noah_pdf_subject_tl,
    document-date-iso .tl_gset:N = \g_noah_date_iso_tl,
    submission-date .tl_gset:N = \g_noah_submission_date_tl,
    submission-date-iso .tl_gset:N = \g_noah_submission_date_iso_tl,
    candidate-number .tl_gset:N = \g_noah_candidate_number_tl,
    toc-depth .code:n = {\setcounter{tocdepth}{#1}}
  }
\NewDocumentCommand{\documentsetup}{m}{\keys_set:nn{noah/setup}{#1}}
\NewDocumentCommand{\candidatenumber}{m}{\tl_gset:Nn\g_noah_candidate_number_tl{#1}}

\cs_new:Npn \NoahCourseName {\tl_use:N\g_noah_course_tl}
\cs_new:Npn \NoahInstructor {\tl_use:N\g_noah_instructor_tl}
\cs_new:Npn \NoahSemester {\tl_use:N\g_noah_semester_tl}
\cs_new:Npn \NoahDepartment {\tl_use:N\g_noah_department_tl}
\cs_new:Npn \NoahUniversity {\tl_use:N\g_noah_university_tl}
\cs_new:Npn \NoahDateISO {\tl_use:N\g_noah_date_iso_tl}
\cs_new:Npn \NoahLogoPath {\tl_use:N\g_noah_logo_tl}
\cs_new:Npn \NoahSubmissionDate {\tl_use:N\g_noah_submission_date_tl}
\cs_new:Npn \NoahSubmissionDateISO
  {\tl_if_blank:VTF\g_noah_submission_date_iso_tl{\NoahDateISO}{\tl_use:N\g_noah_submission_date_iso_tl}}
\cs_new:Npn \NoahCandidateNumber {\tl_use:N\g_noah_candidate_number_tl}

\cs_new:Npn \NoahCourseCompact
  {
    \tl_use:N\g_noah_course_tl
    \tl_if_blank:VF\g_noah_course_code_tl
      {\c_space_tl(\tl_use:N\g_noah_course_code_tl)}
  }
\cs_new:Npn \NoahCourseRunning
  {
    \tl_if_blank:VTF \g_noah_course_short_tl
      {
        \tl_if_blank:VTF \g_noah_course_code_tl
          {\tl_use:N \g_noah_course_tl}
          {\tl_use:N \g_noah_course_code_tl}
      }
      {\tl_use:N \g_noah_course_short_tl}
  }
\cs_new:Npn \NoahCourseShortName
  {
    \tl_if_blank:VTF \g_noah_course_short_tl
      {\tl_use:N \g_noah_course_tl}
      {\tl_use:N \g_noah_course_short_tl}
  }
\cs_new:Npn \NoahRunningTitle
  {
    \tl_if_blank:VTF \g_noah_running_title_tl
      {\ReportTitle}
      {\tl_use:N \g_noah_running_title_tl}
  }
\cs_new_protected:Npn \NoahCourseTitle
  {
    \tl_if_blank:VTF \g_noah_course_code_tl
      {\tl_use:N\g_noah_course_tl}
      {
        \begin{tabularx}{\linewidth}{@{}X>{\raggedleft\arraybackslash}l@{}}
          \tl_use:N\g_noah_course_tl & \tl_use:N\g_noah_course_code_tl
        \end{tabularx}
      }
  }

\cs_new:Npn \NoahAuthorCount {\seq_count:N\g_noah_author_name_seq}
\cs_new:Npn \NoahAuthorsFull {\seq_use:Nn\g_noah_author_name_seq{;\c_space_tl}}

\seq_new:N \l_noah_surname_seq
\cs_new_protected:Npn \noah_surname:n #1
  {
    \seq_set_split:Nnn \l_noah_surname_seq {~} {#1}
    \seq_item:Nn \l_noah_surname_seq {-1}
  }
\cs_new:Npn \NoahAuthorSurnames
  {
    \seq_map_indexed_function:NN \g_noah_author_name_seq \noah_surname_join:nn
  }

\seq_new:N \l_noah_short_name_seq
\cs_new_protected:Npn \noah_short_name:n #1
  {
    \seq_set_split:Nnn \l_noah_short_name_seq { ~ } {#1}
    \int_set:Nn \l_tmpa_int {\seq_count:N\l_noah_short_name_seq}
    \int_compare:nNnTF {\l_tmpa_int} < {3}
      {#1}
      {
        \seq_item:Nn \l_noah_short_name_seq {1}
        \int_step_inline:nnn {2} {\l_tmpa_int-1}
          {
            \c_space_tl
            \exp_args:Ne \tl_head:n
              {\seq_item:Nn \l_noah_short_name_seq {##1}}.
          }
        \c_space_tl\seq_item:Nn \l_noah_short_name_seq {-1}
      }
  }
\cs_new_protected:Npn \NoahPrimaryAuthorShort
  {
    \seq_if_empty:NF \g_noah_author_name_seq
      {
        \exp_args:Ne \noah_short_name:n
          {\seq_item:Nn \g_noah_author_name_seq {1}}
      }
  }
\cs_new:Npn \noah_surname_join:nn #1#2
  {
    \int_compare:nNnF {#1} = {1} {,\c_space_tl}
    \noah_surname:n{#2}
  }

\cs_new_protected:Npn \NoahAssignmentAuthorRows
  {
    \int_set:Nn \l_tmpa_int {\seq_count:N\g_noah_author_name_seq}
    \seq_map_indexed_inline:Nn \g_noah_author_name_seq
      {
        \int_compare:nNnTF {##1} = {1}
          {
            \textbf{\sffamily
              \int_compare:nNnTF {\l_tmpa_int} > {1}
                {\NoahLabelAuthors}{\NoahLabelAuthor}} &
          }
          {&}
        ##2\hfill\seq_item:Nn\g_noah_author_id_seq{##1}\\[1.5mm]
      }
  }
\NewDocumentCommand{\NoahMetadataRow}{mm}
  {\textbf{\sffamily #1} & #2\\[1mm]}
\NewDocumentCommand{\NoahCourseMetadataRow}{}
  {\tl_if_blank:VF\g_noah_course_tl{\textbf{\sffamily\NoahLabelCourse} & \NoahCourseTitle\\[1mm]}}
\NewDocumentCommand{\NoahInstructorMetadataRow}{}
  {\tl_if_blank:VF\g_noah_instructor_tl{\textbf{\sffamily\NoahLabelInstructor} & \NoahInstructor\\[1mm]}}
\NewDocumentCommand{\NoahSemesterMetadataRow}{}
  {\tl_if_blank:VF\g_noah_semester_tl{\textbf{\sffamily\NoahLabelSemester} & \NoahSemester\\[1mm]}}
\NewDocumentCommand{\NoahSubmissionMetadataRow}{}
  {\tl_if_blank:VF\g_noah_submission_date_tl{\textbf{\sffamily\NoahLabelSubmissionDate} & \NoahSubmissionDate\\[1mm]}}
\NewDocumentCommand{\NoahCandidateMetadataRow}{}
  {\tl_if_blank:VF\g_noah_candidate_number_tl{\textbf{\sffamily\NoahLabelCandidate} & \NoahCandidateNumber\\[1mm]}}
\NewDocumentCommand{\NoahIfBlankTF}{mmm}
  {\tl_if_blank:eTF{#1}{#2}{#3}}

\cs_new_protected:Npn \NoahNotesAuthorRows
  {
    \int_set:Nn \l_tmpa_int {\seq_count:N\g_noah_author_name_seq}
    \seq_map_indexed_inline:Nn \g_noah_author_name_seq
      {
        \int_compare:nNnTF {##1} = {1}
          {
            \textbf{\sffamily
              \int_compare:nNnTF {\l_tmpa_int} > {1}
                {\NoahLabelAuthors}{\NoahLabelAuthor}} &
          }
          {&}
        ##2
        \tl_if_blank:eF {\seq_item:Nn\g_noah_author_id_seq{##1}}
          {\hfill\seq_item:Nn\g_noah_author_id_seq{##1}}
        \\[1.5mm]
      }
  }
\ExplSyntaxOff

