\RequirePackage{tocloft}
\renewcommand{\cfttoctitlefont}{\Huge\bfseries\sffamily\color{AUblueDark}}
\renewcommand{\cftaftertoctitle}{\vspace{1.5\baselineskip}}
\renewcommand{\cftsecfont}{\bfseries\sffamily\color{AUblueDark}}
\renewcommand{\cftsecpagefont}{\bfseries\sffamily\color{AUblueDark}}
\renewcommand{\cftsubsecfont}{\sffamily\color{AUblue}}
\renewcommand{\cftsubsecpagefont}{\sffamily\color{AUblue}}
\renewcommand{\cftsubsubsecfont}{\sffamily\color{AUblueDark}}
\renewcommand{\cftsubsubsecpagefont}{\sffamily\color{AUblueDark}}
\renewcommand{\cftsecdotsep}{\cftdotsep}

\newcommand{\NoahInstallTitleCasing}{%
  \let\noah@original@section\section
  \let\noah@original@subsection\subsection
  \let\noah@original@subsubsection\subsubsection
  \RenewDocumentCommand{\section}{s o m}{%
    \IfBooleanTF{##1}
      {\noah@original@section*{\NoahTitleCase{##3}}}
      {\IfNoValueTF{##2}
        {\noah@original@section{\NoahTitleCase{##3}}}
        {\noah@original@section[\NoahTitleCase{##2}]{\NoahTitleCase{##3}}}}%
  }%
  \RenewDocumentCommand{\subsection}{s o m}{%
    \IfBooleanTF{##1}
      {\noah@original@subsection*{\NoahTitleCase{##3}}}
      {\IfNoValueTF{##2}
        {\noah@original@subsection{\NoahTitleCase{##3}}}
        {\noah@original@subsection[\NoahTitleCase{##2}]{\NoahTitleCase{##3}}}}%
  }%
  \RenewDocumentCommand{\subsubsection}{s o m}{%
    \IfBooleanTF{##1}
      {\noah@original@subsubsection*{\NoahTitleCase{##3}}}
      {\IfNoValueTF{##2}
        {\noah@original@subsubsection{\NoahTitleCase{##3}}}
        {\noah@original@subsubsection[\NoahTitleCase{##2}]{\NoahTitleCase{##3}}}}%
  }%
}

