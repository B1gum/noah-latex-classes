\seq_new:N \g_noah_author_name_seq
\seq_new:N \g_noah_author_id_seq
\tl_new:N \g_noah_course_tl
\tl_new:N \g_noah_course_code_tl
\tl_new:N \g_noah_course_short_tl
\tl_new:N \g_noah_running_title_tl
\tl_new:N \g_noah_instructor_tl
\tl_new:N \g_noah_semester_tl
\tl_new:N \g_noah_department_tl
