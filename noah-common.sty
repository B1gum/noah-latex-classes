\newcommand{\noah@namedref}[2]{%
  \begingroup
  \edef\noah@reftitle{\getrefbykeydefault{#2}{name}{}}%
  \hyperref[#2]{#1\ifx\noah@reftitle\@empty\else: \noah@reftitle\fi}%
  \endgroup
}
\newcommand{\mref}[1]{\noah@namedref{\cref*{#1}}{#1}}
\newcommand{\Mref}[1]{\noah@namedref{\Cref*{#1}}{#1}}

\ExplSyntaxOn
\AtBeginDocument{%
  \NoahStoreTitleCase{\noah@pdftitleplain}{\@title}%
  \tl_set:Nx \l_tmpa_tl {\NoahAuthorsFull}
  \tl_set:Nx \l_tmpb_tl {\tl_use:N\g_noah_pdf_subject_tl}
  \tl_if_blank:VTF \l_tmpb_tl
    {
      \ifnoah@assignment
        \tl_set:Nx \l_tmpb_tl {\NoahLabelAssignmentFor\c_space_tl\NoahCourseCompact}
      \else
        \tl_set:Nx \l_tmpb_tl {\NoahLabelLectureNotesFor\c_space_tl\NoahCourseCompact}
      \fi
    }{}
  \ifnoah@anonymous
    \hypersetup{pdftitle={\noah@pdftitleplain},pdfauthor={},pdfsubject={\l_tmpb_tl}}
  \else
    \hypersetup{pdftitle={\noah@pdftitleplain},pdfauthor={\l_tmpa_tl},pdfsubject={\l_tmpb_tl}}
  \fi
}
\ExplSyntaxOff
