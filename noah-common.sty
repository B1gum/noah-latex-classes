% ---------------------------------------------------------------------------
% Page styles, front matter, title-page helpers, and draft mode
% ---------------------------------------------------------------------------
\RequirePackage{fancyhdr}
\RequirePackage{eso-pic}
\newif\ifnoah@infrontmatter
\newif\ifnoah@inmainmatter
\noah@infrontmatterfalse
\noah@inmainmatterfalse

\providecommand{\frontmatter}{%
  \clearpage
  \global\noah@infrontmattertrue
  \global\noah@inmainmatterfalse
  \pagenumbering{roman}%
}
\providecommand{\mainmatter}{%
  \clearpage
  \global\noah@infrontmatterfalse
  \global\noah@inmainmattertrue
  \pagenumbering{arabic}%
}

\newcommand{\NoahTitleStripe}{%
  \AddToShipoutPictureBG*{%
    \AtPageLowerLeft{\color{AUblue}\rule{7mm}{\paperheight}}%
  }%
}
\newcommand{\NoahIncludeLogo}[1]{%
  \begingroup
  \edef\NoahLogoFile{\NoahLogoPath}%
  \IfFileExists{\NoahLogoFile}
    {\includegraphics[width=#1]{\NoahLogoFile}}
    {\PackageWarning{noah-common}{Logo file `\NoahLogoFile' not found; title page will omit it}}%
  \endgroup
}

\ifnoah@draft
  \overfullrule=5pt
  \AddToShipoutPictureBG{%
    \AtPageCenter{%
      \makebox(0,0){\rotatebox{45}{\fontsize{58}{60}\selectfont\sffamily\bfseries\color{AUgray!20}DRAFT}}%
    }%
  }
\fi

